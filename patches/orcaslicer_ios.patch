+// iOS: Boost.Locale isn't built (no ICU/iconv backend), so use CoreFoundation.
+std::string normalize_utf8_nfc(const char *src)
+{
+    CFMutableStringRef str = CFStringCreateMutable(kCFAllocatorDefault, 0);
+    CFStringAppendCString(str, src, kCFStringEncodingUTF8);
+    CFStringNormalize(str, kCFStringNormalizationFormC);
+    CFIndex len = CFStringGetMaximumSizeForEncoding(CFStringGetLength(str), kCFStringEncodingUTF8) + 1;
+    std::string out(size_t(len), '\0');
+    if (!CFStringGetCString(str, out.data(), len, kCFStringEncodingUTF8))
+        out = src;
+    CFRelease(str);
+    out.resize(strlen(out.c_str()));
+    return out;
+}
