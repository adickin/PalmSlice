+void translate_prusa_option(std::string &key, std::string &value)
+{
+    // Same name, different type: PrusaSlicer's is an enum, OrcaSlicer's a bool.
+    if (key == "gcode_label_objects" && value != "0" && value != "1") {
+        value = value == "disabled" ? "0" : "1";
+        return;
+    }
+    if (print_config_def.has(key))
+        return;
+
+    if (key == "external_perimeters_first") {
+        key   = "wall_sequence";
+        value = value == "1" ? "outer wall/inner wall" : "inner wall/outer wall";
+    } else if (key == "ironing") {
+        // PrusaSlicer has an on/off switch plus ironing_type; OrcaSlicer's
+        // ironing_type includes "off". PrusaSlicer's own ironing_type (same
+        // values) would come after this and re-enable ironing, so it's dropped.
+        key   = "ironing_type";
+        value = value == "1" ? "top" : "no ironing";
+    } else if (key == "support_material_auto") {
+        key   = "support_type";
+        value = value == "1" ? "normal(auto)" : "normal(manual)";
+    } else if (key == "support_material_style") {
+        if (value == "organic") {
+            key   = "support_type";
+            value = "tree(auto)";
+        } else {
+            key = "support_style";   // "grid" / "snug" mean the same
+        }
+    } else if (key == "support_material_bottom_contact_distance") {
+        // PrusaSlicer: 0 = same as the top distance.
+        key = value == "0" ? "" : "support_bottom_z_distance";
+    } else if (key == "bed_temperature" || key == "first_layer_bed_temperature") {
+        // One bed temperature → OrcaSlicer's smooth PEI plate (the default plate).
+        key = key == "bed_temperature" ? "hot_plate_temp" : "hot_plate_temp_initial_layer";
+    } else if (key == "seam_position") {
+        if (value == "rear") value = "back";
+    } else if (auto it = s_renamed.find(key); it != s_renamed.end()) {
+        key = it->second;
+    }
+}
+
+} // namespace Slic3r
