+++ b/src/libslic3r/PrusaSettingsImport.hpp
@@ -0,0 +1,18 @@
+#ifndef slic3r_PrusaSettingsImport_hpp_
+#define slic3r_PrusaSettingsImport_hpp_
+
+#include <string>
+
+namespace Slic3r {
+
+// PalmSlice (iOS): reads PrusaSlicer settings — .ini files, PrusaSlicer 3MF
+// projects and per-object settings, profiles saved by PalmSlice's PrusaSlicer
+// backend — by renaming a PrusaSlicer option to OrcaSlicer's, converting the
+// value where the two encode it differently. Options OrcaSlicer defines itself
+// are left alone; key = "" drops an option that has no OrcaSlicer equivalent
+// worth keeping. Called first thing in PrintConfigDef::handle_legacy.
+void translate_prusa_option(std::string &key, std::string &value);
+
+} // namespace Slic3r
+
+#endif
